# =============================================================================
# VecBoost .gitignore - Optimized and Well-Organized
# =============================================================================
#
# Structure:
# 1. IDE & Editors
# 2. AI Assistant Tools
# 3. Operating System Files
# 4. Environment & Configuration
# 5. Rust Build Artifacts
# 6. Python Dependencies
# 7. Testing & Coverage
# 8. Binary & Library Files
# 9. Temporary Files
# =============================================================================

# -----------------------------------------------------------------------------
# 1. IDE & Editors
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 2. AI Assistant Tools
# -----------------------------------------------------------------------------
.claude/
.opencode/
.trae/
.qoder/

# -----------------------------------------------------------------------------
# 3. Operating System Files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# -----------------------------------------------------------------------------
# 4. Environment & Configuration
# -----------------------------------------------------------------------------
.env
.env.local
.env.*
!.env.example
!.env.test

# -----------------------------------------------------------------------------
# 5. Rust Build Artifacts
# -----------------------------------------------------------------------------
target/
*.rs.bk
*.rmeta
# 原规则忽略 `.cargo/config.toml` 并把实体以旧名 `.cargo/config` 入库（目的是给本地
# 覆盖留文件名）。2026-10-18 作废：旧名已使 cargo 1.97 每次构建都打 deprecation 警告，
# 且全仓（含 CI/Dockerfile/scripts）无任何对旧名的引用，本地覆盖本来就走
# `~/.cargo/config.toml` 用户级配置——实体已迁移为 config.toml 并入库，此处不得再忽略，
# 否则干净 clone 会丢失 jemalloc decay 编译期烘焙（防线 6）。
# 需要临时覆盖构建环境变量时，放 `~/.cargo/config.toml` 或直接用环境变量。
.cargo/config

# Note: Cargo.lock SHOULD be tracked - DO NOT add it here
# Keeping Cargo.lock in version control ensures reproducible builds

# -----------------------------------------------------------------------------
# 6. Python Dependencies
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
pip-wheel-metadata/
*.whl
.tox/
.venv/
venv/
env/
.Python
.pytest_cache/

# -----------------------------------------------------------------------------
# 7. Testing & Coverage
# -----------------------------------------------------------------------------
.benchmarks/
coverage.xml
htmlcov/
.coverage
.coverage.*
coverage/
test_report*.json

# -----------------------------------------------------------------------------
# 8. Binary & Library Files
# -----------------------------------------------------------------------------
*.o
*.a
*.so
*.so.*
*.dll
*.dylib
models/
*.wasm
3rdparty/
.gitnexus
.codenexus

# -----------------------------------------------------------------------------
# 9. Temporary Files
# -----------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.backup
temp/

# -----------------------------------------------------------------------------
# 10. Documentation Build (Sphinx, mdBook, etc.)
# -----------------------------------------------------------------------------
docs/_build/
docs/.doctrees/

# -----------------------------------------------------------------------------
# 11. Project Documentation
# -----------------------------------------------------------------------------
AGENTS.md
openspec/
specmark/
CLAUDE.md
IFLOW.md

# -----------------------------------------------------------------------------
# 12. Ignored Project Specific Files
# -----------------------------------------------------------------------------
.iflow/
.ruff_cache/
.sisyphus/
TEST_MODES.md
strix_runs/
security-results/
.corrupted_backup/
.mimosa/
tests/scenario/run/
# Local-only test/spike reports (do not commit)
tests/scenario/report.md
tests/integration/bf16_spike.md
# Local-only i18n audit report (do not commit)
docs/I18N_MISSING_AUDIT.md

# 本机专有评估/台账/安全文档与基准归档（2026-10-17 owner 裁定：禁止入库，本地保留）
docs/TRAIT-KIT-SDK-ASSESSMENT.md
docs/translation-review-ledger.md
docs/MEMORY_SAFETY.md
docs/benchmarks/

# 运行时状态（T035 审查安全9）：模型热度表 / embedding WAL / autotune 指纹
data/
.zcode/

# E2E 质量输出（translate_quality 等 JSON 产物），照 3rdparty/ 先例不入仓库
out/

# -----------------------------------------------------------------------------
# 13. Transcribe PoC（feat/transcribe-own-ort）
# -----------------------------------------------------------------------------
# 大体积音频/模型资产不入库（复制来源与 md5 见本机 `docs-transcribe/DESIGN.md` §1，
# 该文档按 §16 亦不入库）；3rdparty/、models/、*.so.* 已在上方小节忽略，
# 这里覆盖 assets/ 整目录
assets/

# -----------------------------------------------------------------------------
# 14. transcribe-poc 本机目录（2026-10-15 owner 裁定：不发布、与主仓功能面
# 无关，不入 git；本地资产保留，规范面见 docs/MAINTENANCE.md）
# -----------------------------------------------------------------------------
transcribe-poc/

# -----------------------------------------------------------------------------
# 15. tools 孤儿脚本（2026-10-18 owner 裁定：非项目所需，取消跟踪、本地保留）
# - torch_backend_glue.py：唯一消费者是 transcribe-poc/src/pytorch_backend.rs 的
#   include_str!，而该目录已按 §14 不入库——干净 clone 里此脚本无任何引用方
# - gen_scatter.py：产物 scatter.onnx 无入库代码消费，转录主链路的 KV delta 由
#   src/engine/transcribe/asr.rs 原地写回，不经 ScatterND 合并图
# 仍须保留入库：tools/export-1.7b/ —— assets/models/qwen3-*.onnx 的唯一复现
# 路径，被 src/engine/transcribe/asr.rs 直接加载（导出与命名约定见基准文档）
# -----------------------------------------------------------------------------
tools/torch_backend_glue.py
tools/gen_scatter.py

# -----------------------------------------------------------------------------
# 16. 设计文档禁入库（2026-10-18 owner 裁定：PoC 期设计说明类文档一律不得出现在
# git 仓库；本地保留，规范面回落到 docs/MAINTENANCE.md 与 src/engine/transcribe/ 实现）
# - docs-transcribe/DESIGN.md：转录 PoC 期设计稿，含外机 worktree 绝对路径、未入库
#   参考源码行号（docs-transcribe-reference/、transcribe-poc/CONTRACT.md、out/）等
#   本机专有引用，在干净 clone 中必为死链，故取消跟踪
# - 特征链与输入格式的入库事实源已回落到 src/engine/transcribe/features.rs（§6 参数）
#   与 wav.rs（16kHz/单声道/16-bit PCM），文档注释不得再指向本文档
# -----------------------------------------------------------------------------
docs-transcribe/
